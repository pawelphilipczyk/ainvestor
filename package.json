{
	"name": "workspace",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.3.0"
	},
	"scripts": {
		"ensure-deps": "node ./scripts/ensure-deps.mjs",
		"dev": "cross-env NODE_ENV=development node --import remix/node-tsx hmr.ts",
		"start": "node --import remix/node-tsx server.ts",
		"mcp": "node --import remix/node-tsx mcp/server.ts",
		"migrate:gist-to-repo": "node --import remix/node-tsx scripts/migrate-gist-to-repo.ts",
		"typecheck": "tsc --noEmit",
		"test": "npm run -s ensure-deps && node --import remix/node-tsx --test",
		"test:browser": "npm run -s ensure-deps && node --import remix/node-tsx --test \"app/**/*.browser.ts\"",
		"test:smoke:advice": "npm run -s ensure-deps && cross-env RUN_ADVICE_OPENAI_SMOKE=1 node --import remix/node-tsx --test app/features/advice/advice-openai.smoke.test.ts",
		"lint": "biome lint .",
		"format": "biome format .",
		"check": "npm run -s ensure-deps && biome check ."
	},
	"dependencies": {
		"openai": "^6.29.0",
		"remix": "^3.0.0-rc.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@types/node": "^24.5.2",
		"cross-env": "^10.1.0",
		"playwright": "^1.63.0",
		"typescript": "^5.9.2"
	}
}
