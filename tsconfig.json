{
	"include": [
		"server.ts",
		"hmr.ts",
		"app/**/*.ts",
		"app/**/*.tsx",
		"mcp/**/*.ts",
		"scripts/**/*.ts"
	],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node"],
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "remix/ui"
	}
}
